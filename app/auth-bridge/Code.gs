const SCP_AUTH_BRIDGE_SECRET='__SCP_AUTH_SESSION_SECRET__';
const SCP_AUTH_BRIDGE_AUDIENCE='seller-communication-portal';
const SCP_AUTH_BRIDGE_RETURN='https://seller-communication-portal.web.app/';
const SCP_AUTH_BRIDGE_TTL_MS=8*60*60*1000;
function scpAuthB64_(bytes){return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/,'');}
function scpAuthIssue_(email){
  const now=Date.now();
  const payload=scpAuthB64_(Utilities.newBlob(JSON.stringify({v:1,email:String(email||'').trim().toLowerCase(),iat:now,exp:now+SCP_AUTH_BRIDGE_TTL_MS,aud:SCP_AUTH_BRIDGE_AUDIENCE,nonce:Utilities.getUuid()})).getBytes());
  const sig=scpAuthB64_(Utilities.computeHmacSha256Signature(payload,SCP_AUTH_BRIDGE_SECRET,Utilities.Charset.UTF_8));
  return payload+'.'+sig;
}
function scpAuthEsc_(value){return String(value||'').replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c;});}
function doGet(e){
  const email=String(Session.getActiveUser().getEmail()||'').trim().toLowerCase();
  if(!/^[^\s@]+@(shopee\.com|shopeemobile-external\.com)$/i.test(email)){
    return HtmlService.createHtmlOutput('<!doctype html><html><head><base target="_top"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Workspace sign-in required</title><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:#080d1a;color:#e2e8f0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}.card{max-width:540px;width:100%;background:#0f172a;border:1px solid #1e293b;border-radius:20px;padding:36px;box-shadow:0 24px 64px rgba(0,0,0,0.65);position:relative;overflow:hidden}.card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:#ef4444}h2{color:#ffffff;font-size:22px;margin:12px 0 8px 0}p{color:#94a3b8;font-size:14px;line-height:1.6;margin-bottom:12px}</style></head><body><main class="card"><div style="font-size:11px;font-weight:800;letter-spacing:0.12em;color:#ef4444">ACCESS RESTRICTED</div><h2>Seller Communication Portal</h2><p>Corporate Workspace identity could not be verified.</p><p>Open this page with your Shopee Work Google profile (<strong>@shopee.com</strong>).</p></main></body></html>').setTitle('Workspace sign-in required');
  }
  const token=scpAuthIssue_(email);
  const target=SCP_AUTH_BRIDGE_RETURN+'?workspace=verified#scp_session='+encodeURIComponent(token);
  const href=scpAuthEsc_(target);
  const shown=scpAuthEsc_(email);
  return HtmlService.createHtmlOutput('<!doctype html><html><head><base target="_top"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Workspace verified · Seller Communication Portal</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:"Inter",-apple-system,BlinkMacSystemFont,sans-serif;background:#080d1a;color:#e2e8f0;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}.card{max-width:580px;width:100%;background:#0f172a;border:1px solid #1e293b;border-radius:20px;padding:36px 32px;box-shadow:0 24px 64px rgba(0,0,0,0.65);position:relative;overflow:hidden}.card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#ee4d2d,#f59e0b)}.badge-strip{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.brand-eyebrow{font-size:11px;font-weight:800;letter-spacing:0.12em;color:#ee4d2d;text-transform:uppercase}.status-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:9999px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.3);color:#34d399;font-size:11px;font-weight:600;font-family:"JetBrains Mono",monospace}.dot{width:6px;height:6px;border-radius:50%;background:#10b981;box-shadow:0 0 8px #10b981}h2{color:#ffffff;font-size:24px;font-weight:800;letter-spacing:-0.02em;margin-bottom:8px}p{font-size:13.5px;color:#94a3b8;line-height:1.6;margin-bottom:12px}.user-box{display:flex;align-items:center;gap:12px;background:#090d16;border:1px solid #1e293b;border-radius:12px;padding:12px 16px;margin:16px 0}.avatar{width:34px;height:34px;border-radius:50%;background:rgba(238,77,45,0.15);border:1px solid rgba(238,77,45,0.3);display:flex;align-items:center;justify-content:center;color:#ee4d2d;font-weight:800;font-size:14px;flex-shrink:0}.user-meta{display:flex;flex-direction:column;overflow:hidden}.user-email{font-family:"JetBrains Mono",monospace;color:#ffffff;font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.user-tag{color:#64748b;font-size:11px}.btn-continue{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#ee4d2d;color:#ffffff;text-decoration:none;font-weight:700;font-size:14.5px;padding:14px 20px;border-radius:12px;box-shadow:0 4px 16px rgba(238,77,45,0.35);transition:all 0.15s ease;cursor:pointer;margin-top:8px}.btn-continue:hover{background:#d73211;box-shadow:0 6px 20px rgba(238,77,45,0.5)}.note{font-size:12px;color:#64748b;line-height:1.5;margin-top:16px;text-align:center}</style></head><body><main class="card"><div class="badge-strip"><span class="brand-eyebrow">Shopee Seller Education</span><span class="status-pill"><span class="dot"></span>SSO Verified</span></div><h2>Workspace verified</h2><p>Authentication confirmed. You are signed in as:</p><div class="user-box"><div class="avatar">&#10003;</div><div class="user-meta"><span class="user-email">'+shown+'</span><span class="user-tag">Shopee Corporate Workspace Account</span></div></div><p style="margin-bottom:8px">Click once to complete sign-in and return to the Portal:</p><a id="continuePortal" href="'+href+'" target="_top" class="btn-continue">Continue to Seller Communication Portal</a><p class="note">This button intentionally performs a top-level handoff so the Portal is not trapped inside the Apps Script iframe.</p><script>document.getElementById("continuePortal").focus();<\/script></main></body></html>').setTitle('Workspace verified');
}
