function peopleSeedV474Ready_() {
  try {
    const users = readObjects_(PORTAL_DB_SPREADSHEET_ID, 'Users');
    const activeByEmail = {};
    users.forEach(function(r){
      const email = String(r.email || r.source_identity || '').toLowerCase();
      if (email && String(r.status || '').toUpperCase() === 'ACTIVE') activeByEmail[email] = r;
    });
    const expected = PEOPLE_SEED_V474_PART1.concat(PEOPLE_SEED_V474_PART2);
    const missing = expected.filter(function(r){ return !activeByEmail[String(r.email || '').toLowerCase()]; });
    const admin = activeByEmail['sellereducation.th@shopee.com'];
    return missing.length === 0 && !!admin && String(admin.role || '').toUpperCase() === 'ADMIN';
  } catch (ignore) { return false; }
}

function ensurePeopleSeedV474IfNeeded_(actorEmail) {
  if (peopleSeedV474Ready_()) return {skipped:true,reason:'ALREADY_VERIFIED',verifiedActive:PEOPLE_SEED_V474_EXPECTED,inserted:0,updated:0,errors:0};
  return seedProvidedPeopleV474_(actorEmail);
}

function seedProvidedPeopleV474_(actorEmail) {
  const actor = actorEmail || 'SETUP';
  const first = massImportUsersCore_({
    rows: PEOPLE_SEED_V474_PART1,
    mode: 'UPSERT_BY_EMAIL',
    fileName: 'seller-comms-people-import-part-01.csv',
    templateVersion: PEOPLE_SEED_V474_VERSION,
    source: 'SETUP_SEED',
    autoCreateTeams: true
  }, actor);
  const second = massImportUsersCore_({
    rows: PEOPLE_SEED_V474_PART2,
    mode: 'UPSERT_BY_EMAIL',
    fileName: 'seller-comms-people-import-part-02.csv',
    templateVersion: PEOPLE_SEED_V474_VERSION,
    source: 'SETUP_SEED',
    autoCreateTeams: true
  }, actor);
  const users = readObjects_(PORTAL_DB_SPREADSHEET_ID, 'Users').filter(function(r){ return corporateEmail_(r.email || r.source_identity); });
  const active = users.filter(function(r){ return String(r.status || '').toUpperCase() === 'ACTIVE'; });
  const activeByEmail = {}; active.forEach(function(r){ activeByEmail[String(r.email || r.source_identity || '').toLowerCase()] = r; });
  const expectedEmails = PEOPLE_SEED_V474_PART1.concat(PEOPLE_SEED_V474_PART2).map(function(r){ return String(r.email || '').toLowerCase(); });
  const missingEmails = expectedEmails.filter(function(email){ return !activeByEmail[email]; });
  const admin = activeByEmail['sellereducation.th@shopee.com'];
  if (missingEmails.length || !admin || String(admin.role || '').toUpperCase() !== 'ADMIN') {
    throw new Error('People recovery verification failed: '+missingEmails.length+' expected active identities are missing or bootstrap admin is invalid.');
  }
  const result = {
    inserted:Number(first.inserted||0)+Number(second.inserted||0),
    updated:Number(first.updated||0)+Number(second.updated||0),
    skipped:Number(first.skipped||0)+Number(second.skipped||0),
    errors:Number(first.errors||0)+Number(second.errors||0),
    jobs:[first.job||null,second.job||null],
    verifiedUsers:users.length,
    verifiedActive:active.length,
    bootstrapAdmin:true
  };
  upsertConfigValue_('PEOPLE_SEED_V474_STATUS','COMPLETED','People & Roles recovery seed verified from two <=500-row jobs.',actor);
  upsertConfigValue_('PEOPLE_SEED_V474_COUNT',String(active.length),'Verified active People & Roles identities after recovery seed.',actor);
  return result;
}
function seedProvidedPeopleV460_(actorEmail) { return seedProvidedPeopleV474_(actorEmail); }

// v4.8.0 setup-only, non-destructive self-heal.
// Existing user rows are never bulk-overwritten. Missing bundled identities are inserted,
// and only the currently signed-in bundled ADMIN may be repaired to its packaged ADMIN row
// before the first successful LIVE_SYNC READY state.
function liveSyncSetupReadyV480_(){
  try{
    const rows=readObjects_(PORTAL_DB_SPREADSHEET_ID,'Config');
    const r=rows.find(function(x){return String(x.key||'').toUpperCase()==='LIVE_SYNC_SETUP_STATUS';});
    return !!r&&String(r.value||'').toUpperCase()==='READY';
  }catch(ignore){return false;}
}
function ensurePeopleSeedV480ForSetup_(actorEmail){
  ensurePeopleSchema_();
  if(peopleSeedV474Ready_())return {skipped:true,reason:'ALREADY_VERIFIED',verifiedActive:PEOPLE_SEED_V474_EXPECTED,inserted:0,updated:0,errors:0,selfHeal:'NONE'};
  if(liveSyncSetupReadyV480_())throw new Error('People & Roles baseline is incomplete after a previously READY setup. Automatic bootstrap repair is disabled to protect current role/status decisions.');
  const actor=String(actorEmail||'').trim().toLowerCase();
  const expected=PEOPLE_SEED_V474_PART1.concat(PEOPLE_SEED_V474_PART2);
  const users=readObjects_(PORTAL_DB_SPREADSHEET_ID,'Users');
  const byEmail={};users.forEach(function(u){const e=String(u.email||u.source_identity||'').trim().toLowerCase();if(e)byEmail[e]=u;});
  const missing=expected.filter(function(r){return !byEmail[String(r.email||'').toLowerCase()];});
  let inserted=0,updated=0,skipped=0,jobs=[];
  if(missing.length){
    const m1=missing.filter(function(r){return Number(r.sourceRowNumber||0)>=0&&PEOPLE_SEED_V474_PART1.some(function(x){return String(x.email||'').toLowerCase()===String(r.email||'').toLowerCase();});});
    const m2=missing.filter(function(r){return !m1.some(function(x){return String(x.email||'').toLowerCase()===String(r.email||'').toLowerCase();});});
    [m1,m2].forEach(function(rows,idx){if(!rows.length)return;const out=massImportUsersCore_({rows:rows,mode:'SKIP_EXISTING',fileName:'v4.8.0-self-heal-missing-part-'+(idx+1)+'.csv',templateVersion:PEOPLE_SEED_V474_VERSION,source:'SETUP_SELF_HEAL_MISSING',autoCreateTeams:true},actor||'SETUP');inserted+=Number(out.inserted||0);updated+=Number(out.updated||0);skipped+=Number(out.skipped||0);jobs.push(out.job||null);});
  }
  const adminSeed=expected.find(function(r){return String(r.email||'').toLowerCase()===actor&&String(r.role||'').toUpperCase()==='ADMIN'&&r.active===true;});
  const nowUsers=readObjects_(PORTAL_DB_SPREADSHEET_ID,'Users');
  const actorRow=nowUsers.find(function(u){return String(u.email||u.source_identity||'').trim().toLowerCase()===actor;});
  if(adminSeed&&(!actorRow||String(actorRow.role||'').toUpperCase()!=='ADMIN'||String(actorRow.status||'').toUpperCase()!=='ACTIVE')){
    const out=massImportUsersCore_({rows:[adminSeed],mode:'UPSERT_BY_EMAIL',fileName:'v4.8.0-self-heal-current-admin.csv',templateVersion:PEOPLE_SEED_V474_VERSION,source:'SETUP_SELF_HEAL_ADMIN',autoCreateTeams:true},actor||'SETUP');
    inserted+=Number(out.inserted||0);updated+=Number(out.updated||0);skipped+=Number(out.skipped||0);jobs.push(out.job||null);
  }
  const finalUsers=readObjects_(PORTAL_DB_SPREADSHEET_ID,'Users');
  const activeByEmail={};finalUsers.forEach(function(u){const e=String(u.email||u.source_identity||'').trim().toLowerCase();if(e&&String(u.status||'').toUpperCase()==='ACTIVE')activeByEmail[e]=u;});
  const missingActive=expected.map(function(r){return String(r.email||'').toLowerCase();}).filter(function(e){return !activeByEmail[e];});
  if(missingActive.length)throw new Error('People self-heal preserved existing role/status decisions but '+missingActive.length+' bundled identities are still missing or inactive. Review People & Roles before retrying setup.');
  const seedAdmin=activeByEmail['sellereducation.th@shopee.com'];
  if(!seedAdmin||String(seedAdmin.role||'').toUpperCase()!=='ADMIN')throw new Error('People self-heal verification failed: sellereducation.th@shopee.com is not an active ADMIN.');
  upsertConfigValue_('PEOPLE_SEED_V474_STATUS','COMPLETED','v4.8.0 non-destructive People self-heal verified bundled identities.',actor||'SETUP');
  upsertConfigValue_('PEOPLE_SEED_V474_COUNT',String(Object.keys(activeByEmail).length),'Verified active People identities after v4.8.0 self-heal.',actor||'SETUP');
  return {inserted:inserted,updated:updated,skipped:skipped,errors:0,jobs:jobs,verifiedActive:Object.keys(activeByEmail).length,selfHeal:'NON_DESTRUCTIVE'};
}

