<script>
const MAX=2000, REQUIRED=['email','role','department','active','can_review_pn','can_review_sc','can_review_artwork','can_manage_cycles','can_manage_notifications'], ROLES=['REQUESTER','COMMS','REVIEWER','ADMIN'];
const aliases={email:'email',e_mail:'email',mail:'email',display_name:'display_name',displayname:'display_name',name:'display_name',full_name:'display_name',role:'role',portal_role:'role',department:'department',dept:'department',team:'team',team_name:'team',team_clus:'team_cluster',team_cluster:'team_cluster',cluster:'team_cluster',team_cat:'team_category',team_category:'team_category',team_role:'team_role',manager_email:'manager_email',direct_manager_email:'manager_email',active:'active',can_review_pn:'can_review_pn',can_review_sc:'can_review_sc',can_review_artwork:'can_review_artwork',can_manage_cycles:'can_manage_cycles',can_manage_notifications:'can_manage_notifications'};
let state=null,allowed=false;const $=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function key(v){const x=String(v||'').trim().toLowerCase().replace(/[()]/g,'').replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'');return aliases[x]||x}function clean(v){const x=String(v||'').trim();return /^(#?n\\/a|na|null|none|-)$/i.test(x)?'':x}function bool(v,def){const x=String(v??'').trim().toLowerCase();if(['true','yes','y','1','active'].includes(x))return true;if(['false','no','n','0','inactive'].includes(x))return false;if(!x)return !!def;return null}function corp(v){return /^[^\\s@]+@(shopee\\.com|shopeemobile-external\\.com)$/i.test(String(v||'').trim())}
function delim(t){const f=String(t||'').replace(/^\\ufeff/,'').split(/\\r?\\n/,1)[0]||'';return [[',',(f.match(/,/g)||[]).length],['\\t',(f.match(/\\t/g)||[]).length],[';',(f.match(/;/g)||[]).length]].sort((a,b)=>b[1]-a[1])[0][0]}
function parse(t){t=String(t||'').replace(/^\\ufeff/,'');const d=delim(t),rows=[];let row=[],cell='',q=false;for(let i=0;i<t.length;i++){const c=t[i];if(q){if(c==='"'&&t[i+1]==='"'){cell+='"';i++}else if(c==='"')q=false;else cell+=c}else if(c==='"')q=true;else if(c===d){row.push(cell);cell=''}else if(c==='\\n'){row.push(cell.replace(/\\r$/,''));rows.push(row);row=[];cell=''}else cell+=c}if(cell.length||row.length){row.push(cell.replace(/\\r$/,''));rows.push(row)}return rows.filter(r=>r.some(v=>String(v).trim()))}
function validate(matrix){if(!matrix.length)throw new Error('File is empty.');const h=matrix[0].map(key),missing=REQUIRED.filter(x=>!h.includes(x));if(missing.length)throw new Error('Missing columns: '+missing.join(', '));const seen=new Set(),out=[];let ignored=0;matrix.slice(1).forEach((raw,i)=>{const o={};h.forEach((x,j)=>o[x]=String(raw[j]??'').trim());o.email=String(o.email||'').trim();o.role=String(o.role||'REQUESTER').toUpperCase();o.department=String(o.department||'').trim();o.team_cluster=clean(o.team_cluster);o.team_category=clean(o.team_category);o.team_role=clean(o.team_role);const parts=[o.team_cluster,o.team_category,o.team_role].filter(Boolean);o.team=clean(o.team)||(parts.length?parts.join(' / '):'Unassigned');const signal=[o.department,o.team_cluster,o.team_category,o.team_role,o.manager_email,o.can_review_pn,o.can_review_sc,o.can_review_artwork,o.can_manage_cycles,o.can_manage_notifications].some(v=>String(v||'').trim()&&String(v||'').toUpperCase()!=='FALSE');if(!o.email&&!signal){ignored++;return}o.active=bool(o.active,true);['can_review_pn','can_review_sc','can_review_artwork','can_manage_cycles','can_manage_notifications'].forEach(k=>o[k]=bool(o[k],false));const e=[];if(!o.email)e.push('Email required');else if(!corp(o.email))e.push('Corporate email required');const ek=o.email.toLowerCase();if(ek&&seen.has(ek))e.push('Duplicate email');if(ek)seen.add(ek);if(!ROLES.includes(o.role))e.push('Invalid role');if(!o.department)e.push('Department required');if(o.manager_email&&!corp(o.manager_email))e.push('Invalid manager email');if(o.active===null)e.push('Invalid active');['can_review_pn','can_review_sc','can_review_artwork','can_manage_cycles','can_manage_notifications'].forEach(k=>{if(o[k]===null)e.push('Invalid '+k)});out.push({...o,rowNumber:i+2,errors:e})});if(out.length>MAX)throw new Error('Maximum '+MAX+' people per job.');return {rows:out,ignored}}
function render(){const rows=state.rows,bad=rows.filter(r=>r.errors.length);$('preview').innerHTML='<div class="grid"><div class="stat"><span>People rows</span><strong>'+rows.length+'</strong></div><div class="stat"><span>Ready</span><strong>'+(rows.length-bad.length)+'</strong></div><div class="stat"><span>Errors</span><strong>'+bad.length+'</strong></div><div class="stat"><span>Ignored blanks</span><strong>'+state.ignored+'</strong></div><div class="stat"><span>Mode</span><strong>UPSERT</strong></div></div><div class="tablewrap"><table><thead><tr><th>Row</th><th>Email</th><th>Role</th><th>Organization</th><th>Validation</th></tr></thead><tbody>'+rows.slice(0,80).map(r=>'<tr><td>'+r.rowNumber+'</td><td><strong>'+esc(r.email)+'</strong></td><td>'+esc(r.role)+'</td><td><strong>'+esc(r.department)+'</strong><br><span class="muted">'+esc(r.team)+'</span></td><td>'+(r.errors.length?'<span class="err">'+esc(r.errors.join(' · '))+'</span>':'<span style="color:#12866f;font-weight:800">Ready</span>')+'</td></tr>').join('')+'</tbody></table></div>'; $('importBtn').disabled=!allowed||!!bad.length||!rows.length;$('mode').disabled=!allowed}
$('file').addEventListener('change',async e=>{const f=e.target.files&&e.target.files[0];if(!f)return;$('fileName').textContent='Selected: '+f.name;try{state=validate(parse(await f.text()));state.fileName=f.name;render()}catch(err){state=null;$('preview').innerHTML='<div class="access bad">'+esc(err.message||err)+'</div>';$('importBtn').disabled=true}});
$('importBtn').addEventListener('click',()=>{if(!state)return;const btn=$('importBtn'),result=$('result');btn.disabled=true;btn.textContent='Importing…';result.style.display='none';const rows=state.rows.map(r=>({email:r.email,displayName:r.display_name||'',role:r.role,department:r.department,team:r.team,teamCluster:r.team_cluster,teamCategory:r.team_category,teamRole:r.team_role,managerEmail:r.manager_email||'',active:r.active,canReviewPn:r.can_review_pn,canReviewSc:r.can_review_sc,canReviewArtwork:r.can_review_artwork,canManageCycles:r.can_manage_cycles,canManageNotifications:r.can_manage_notifications,sourceRowNumber:r.rowNumber}));google.script.run.withSuccessHandler(res=>{result.className='result';result.style.display='block';result.innerHTML='<strong>Import complete.</strong> '+Number(res.inserted||0)+' inserted · '+Number(res.updated||0)+' updated · '+Number(res.skipped||0)+' skipped.';btn.textContent='Imported';}).withFailureHandler(err=>{result.className='result bad';result.style.display='block';result.textContent=(err&&err.message)||String(err);btn.disabled=false;btn.textContent='Retry Import';}).massImportUsersFromSecurePage({rows,mode:$('mode').value,fileName:state.fileName,templateVersion:'2.0',autoCreateTeams:true});});
