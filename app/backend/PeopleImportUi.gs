/** Workspace-secured People & Roles import console for Firebase-hosted Portal. */
function getPeopleImportAccess(){
  ensurePeopleSchema_();
  const email=String(Session.getActiveUser().getEmail()||'').trim();
  if(!email)return {allowed:false,email:'',message:'Workspace identity is not visible to this deployment. For security, import is blocked instead of falling back to the deployer identity.'};
  try{assertCorporateUser_(email);assertAdminUser_(email);return {allowed:true,email:email,message:'Admin access verified.'};}
  catch(err){return {allowed:false,email:email,message:String(err&&err.message?err.message:err)};}
}
function massImportUsersFromSecurePage(payload){
  ensurePeopleSchema_();
  const email=String(Session.getActiveUser().getEmail()||'').trim();
  if(!email)throw new Error('Workspace identity unavailable. Import blocked for security.');
  assertCorporateUser_(email);assertAdminUser_(email);
  return massImportUsersCore_(payload||{},email);
}
